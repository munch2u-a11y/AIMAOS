<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default security configuration: Enforce HTTPS/TLS on public traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext traffic ONLY for local private subnets (IPv4 LAN development) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator loopback alias -->
    </domain-config>
</network-security-config>
